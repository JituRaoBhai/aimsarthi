{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      ".git/**",
      ".firebase/**",
      "**/.DS_Store",
      "**/node_modules/**",
      "functions/**",
      "tools/**",
      "store/**",
      "*.txt",
      "*.md",
      "*.csv"
    ],
    "rewrites": [
      {
        "source": "/api/ai",
        "function": {
          "functionId": "ai",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/live",
        "function": {
          "functionId": "live",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ]
}