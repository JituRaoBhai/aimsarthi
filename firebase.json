{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "**/.*", "**/node_modules/**", "functions/**", "tools/**", "*.txt", "*.md", "*.csv"],
    "rewrites": [
      { "source": "/api/ai", "function": { "functionId": "ai", "region": "us-central1" } },
      { "source": "/api/live", "function": { "functionId": "live", "region": "us-central1" } }
    ],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" },
  "functions": [
    { "source": "functions", "codebase": "default", "ignore": ["node_modules", ".git", "*.log"] }
  ]
}
