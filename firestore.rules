rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function userKeys() { return ['username','qSalt','qHash','contactEmail','createdAt','lastActive','exam','examDate','level','daysUsed','streak','tasksTotal','tasksDone','minutesStudied','app']; }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(userKeys());
      allow update: if isOwner(uid) && request.resource.data.username == resource.data.username
                    && request.resource.data.qHash == resource.data.qHash
                    && request.resource.data.keys().hasOnly(userKeys());
    }
    match /states/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && request.resource.data.keys().hasOnly(['json','updatedAt']) && request.resource.data.json.size() < 900000;
    }
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.type in ['problem','suggestion']
                    && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 600
                    && request.resource.data.keys().hasOnly(['uid','username','type','message','contact','exam','app','status','createdAt']);
      allow read, update, delete: if isAdmin();
    }
    match /strategies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
